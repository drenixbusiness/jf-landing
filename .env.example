# Telegram bot that posts quote requests into your group.
# 1. Create a bot with @BotFather and copy its token.
# 2. Add the bot to your group, send any message in the group,
#    then open https://api.telegram.org/bot<TOKEN>/getUpdates and copy chat.id
#    (group ids are negative, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CARTO Basemaps key for the office map — https://carto.com/basemaps/apikey
# Public by design (it is sent with every map tile request). Restrict it to your
# domain in the CARTO dashboard.
NEXT_PUBLIC_CARTO_KEY=
